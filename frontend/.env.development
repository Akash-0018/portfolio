# Leave empty so the browser requests same-origin /api/... and Vite's dev proxy
# (see vite.config.js) forwards to the backend.
#
# Setting an absolute URL here makes the browser call the backend cross-origin
# instead, which then requires the dev server's exact port to be listed in the
# backend's CORS_ORIGINS. Vite picks the next free port when 5173 is taken, so
# that breaks the moment another project is running - and it surfaces as a
# generic "Authentication failed." rather than a CORS error.
VITE_API_URL=
