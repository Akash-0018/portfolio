# Production build. The SPA and the API are served from the same origin by the
# single container, so the API base URL must be empty -> requests go to /api/...
#
# Do NOT set this to "*". That produces a literal "*/api" axios baseURL and every
# request goes to /*/api/... Vite gives .env.production precedence over .env, so
# this file is what the production build actually uses.
VITE_API_URL=
